{
  "name": "worklog-timeline",
  "private": true,
  "version": "0.1.0",
  "description": "날짜별 업무 기록과 증빙을 모아 보는 타임라인. 기록과 이미지는 데이터 폴더에 파일로 저장하고 Word와 PDF로 내보냅니다.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "docx-preview": "^0.4.1",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
